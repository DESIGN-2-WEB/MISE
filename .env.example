# Copy to .env and fill in before building for production.

# Public address of the site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, structured data and sitemap.xml.
VITE_SITE_URL=https://www.example.com

# Address shown on the contact page and in the legal pages.
VITE_CONTACT_EMAIL=hello@example.com

# TheMealDB API key. The shared test key "1" is for development only;
# TheMealDB asks you to become a supporter before releasing an app publicly.
VITE_MEALDB_API_KEY=1
