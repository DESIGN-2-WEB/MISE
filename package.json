{
  "name": "mise",
  "private": true,
  "version": "1.0.0",
  "description": "Mise: a free recipe finder with a weekly meal planner and step-by-step cooking mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.js --outDir dist/.server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
